{
  "schema_version": 2,
  "description": "Per-track correction using direct values",
  "corrections": [
    {
      "name": "x_per_track_direct",
      "version": 1,
      "description": "Direct lookup: for each track index, apply specific offset value",
      "inputs": [
        {
          "name": "PPSLocalTrack_x",
          "type": "real",
          "description": "Raw X position [mm]"
        },
        {
          "name": "track_idx",
          "type": "int",
          "description": "Track index in event array"
        }
      ],
      "output": {
        "name": "correction_offset",
        "type": "real",
        "description": "Correction offset to add to X [mm]"
      },
      "data": {
        "nodetype": "category",
        "input": "track_idx",
        "content": [
          {"key": 0, "value": 1},
          {"key": 1, "value": 2},
          {"key": 2, "value": 3},
          {"key": 3, "value": 4},
          {"key": 4, "value": 5},
          {"key": 5, "value": 6},
          {"key": 6, "value": 7},
          {"key": 7, "value": 8},
          {"key": 8, "value": 9},
          {"key": 9, "value": 10},
          {"key": 10, "value": 11},
          {"key": 11, "value": 12 }
        ],
        "default": 0.0
      }
    }
  ],
  "metadata": {
    "input_column": "PPSLocalTrack_x",
    "output_column": "PPSLocalTrack_x_corrected"
  }
}
